// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model User {
  // Basic fields
  id            String    @id @default(cuid())
  name          String
  username      String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  biography     String?

  // Privacy settings
  isPrivate Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())

  accounts      Account[]
  flashcardSets FlashcardSet[] // Relation to their created sets
  folders       Folder[]       @relation("FolderOwner")
  ownedClasses  Classroom[]    @relation("ClassroomOwner")
  classMembers  ClassMember[]

  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model FlashcardSet {
  id          String                 @id @default(cuid())
  title       String
  description String?
  visibility  FlashcardSetVisibility @default(PUBLIC)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  // Relations
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
  folders    FolderFlashcardSet[]
  classes    ClassFlashcardSet[]

  @@index([userId]) // Quick lookup for a user's sets
}

model Flashcard {
  id         String   @id @default(cuid())
  term       String // e.g., "CPU"
  definition String // e.g., "Brain of the computer"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  flashcardSetId String
  flashcardSet   FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@index([flashcardSetId]) // Quick lookup for cards within a specific set
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId       String
  owner         User                 @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  flashcardSets FolderFlashcardSet[]

  @@index([ownerId])
}

model FolderFlashcardSet {
  folderId       String
  flashcardSetId String

  folder       Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@id([folderId, flashcardSetId])
  @@index([flashcardSetId])
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId       String
  owner         User                @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       ClassMember[]
  flashcardSets ClassFlashcardSet[]

  @@index([ownerId])
}

model ClassMember {
  classroomId String
  userId      String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model ClassFlashcardSet {
  classroomId    String
  flashcardSetId String

  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@id([classroomId, flashcardSetId])
  @@index([flashcardSetId])
}

enum UserRole {
  ADMIN
  USER
}

enum FlashcardSetVisibility {
  PRIVATE
  PUBLIC
}
